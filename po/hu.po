#: crates/linux-defender-core/src/audit.rs:347
msgid "ClamAV is not installed"
msgstr "A ClamAV nincs telepítve"

#: crates/linux-defender-core/src/audit.rs:349
msgid "Install ClamAV to enable virus scanning"
msgstr "Telepítse a ClamAV-ot a víruskeresés engedélyezéséhez"

#: crates/linux-defender-core/src/audit.rs:367
msgid "Installed: {version}"
msgstr "Telepítve: {version}"

#: crates/linux-defender-core/src/audit.rs:379
msgid "Up to date ({days} day old, built {date})"
msgid_plural "Up to date ({days} days old, built {date})"
msgstr[0] "Naprakész ({days} napos, létrehozva: {date})"
msgstr[1] "Naprakész ({days} napos, létrehozva: {date})"

#: crates/linux-defender-core/src/audit.rs:397
#: crates/linux-defender-core/src/audit.rs:417
msgid "Database is {days} day old (built {date})"
msgid_plural "Database is {days} days old (built {date})"
msgstr[0] "Az adatbázis {days} napos (létrehozva: {date})"
msgstr[1] "Az adatbázis {days} napos (létrehozva: {date})"

#: crates/linux-defender-core/src/audit.rs:405
msgid "Update virus database to ensure protection"
msgstr "Frissítse a vírusadatbázist a védelem biztosításához"

#: crates/linux-defender-core/src/audit.rs:425
msgid "Database is critically outdated. Update immediately."
msgstr "Az adatbázis kritikusan elavult. Azonnal frissítse."

#: crates/linux-defender-core/src/audit.rs:446
msgid "Database files exist but age could not be determined"
msgstr "Léteznek adatbázisfájlok, de a koruk nem állapítható meg"

#: crates/linux-defender-core/src/audit.rs:448
msgid "No virus database found"
msgstr "Nem található vírusadatbázis"

#: crates/linux-defender-core/src/audit.rs:452
msgid "Download virus database"
msgstr "Vírusadatbázis letöltése"

#: crates/linux-defender-core/src/audit.rs:470
msgid "Service {name} is running"
msgstr "A(z) {name} szolgáltatás fut"

#: crates/linux-defender-core/src/audit.rs:482
msgid "Daemon is responding"
msgstr "A démon válaszol"

#: crates/linux-defender-core/src/audit.rs:490
msgid "ClamAV daemon is not running"
msgstr "A ClamAV démon nem fut"

#: crates/linux-defender-core/src/audit.rs:492
msgid "Start the daemon for faster scanning"
msgstr "Indítsa el a démont a gyorsabb vizsgálathoz"

#: crates/linux-defender-core/src/audit.rs:509
msgid "Freshclam service is active"
msgstr "A freshclam szolgáltatás aktív"

#: crates/linux-defender-core/src/audit.rs:517
msgid "Freshclam automatic update service is not running"
msgstr "A freshclam automatikus frissítő szolgáltatás nem fut"

#: crates/linux-defender-core/src/audit.rs:519
msgid "Enable automatic database updates"
msgstr "Automatikus adatbázis-frissítések engedélyezése"

#: crates/linux-defender-core/src/audit.rs:543
msgid "Scheduled scans are enabled"
msgstr "Scheduled scans are enabled"

#: crates/linux-defender-core/src/audit.rs:551
msgid "Scheduled scans are not enabled"
msgstr "Scheduled scans are not enabled"

#: crates/linux-defender-core/src/audit.rs:553
msgid "Enable scheduled scans in Preferences → Schedule"
msgstr "Enable scheduled scans in Preferences → Schedule"

#: crates/linux-defender-core/src/audit.rs:561
msgid "No scheduling backend is available on this system"
msgstr "Ezen a rendszeren nincs elérhető időzítő backend"

#: crates/linux-defender-core/src/audit.rs:563
msgid "Scheduled scans require a systemd user session or cron"
msgstr "A naplózott vizsgálatokhoz szükséges systemd user session vagy cron"

#: crates/linux-defender-core/src/audit.rs:749
msgid "Open Ports"
msgstr "Open Ports"

#: crates/linux-defender-core/src/audit.rs:755
msgid "{count} port listening, risky ports: {ports}"
msgid_plural "{count} ports listening, risky ports: {ports}"
msgstr[0] "{count} port figyel, kockázatos portok: {ports}"
msgstr[1] "{count} port figyel, kockázatos portok: {ports}"

#: crates/linux-defender-core/src/audit.rs:766
msgid "Review if these services need to be exposed"
msgstr ""
"Ellenőrizze, hogy ezeket a szolgáltatásokat szükséges-e elérhetővé tenni"

#: crates/linux-defender-core/src/audit.rs:773
msgid "{count} port listening"
msgid_plural "{count} ports listening"
msgstr[0] "{count} port figyel"
msgstr[1] "{count} port figyel"

#: crates/linux-defender-core/src/audit.rs:781
msgid "Review open ports and close unnecessary services"
msgstr ""
"Ellenőrizze a nyitott portokat, és zárja le a felesleges szolgáltatásokat"

#: crates/linux-defender-core/src/audit.rs:791
#: crates/linux-defender-core/src/network.rs:220
msgid "Some network socket rows could not be read."
msgstr "Néhány hálózati foglalatsor nem volt olvasható."

#: crates/linux-defender-core/src/audit.rs:798
msgid "No open ports detected"
msgstr "Nem található nyitott port"

#: crates/linux-defender-core/src/audit.rs:832
msgid "AppArmor is enabled"
msgstr "Az AppArmor engedélyezve van"

#: crates/linux-defender-core/src/audit.rs:840
msgid "AppArmor module is loaded but not enabled"
msgstr "Az AppArmor modul betöltve, de nincs engedélyezve"

#: crates/linux-defender-core/src/audit.rs:842
msgid "Enable AppArmor for application sandboxing"
msgstr "Engedélyezze az AppArmort az alkalmazások elszigeteléséhez"

#: crates/linux-defender-core/src/audit.rs:858
msgid "SELinux is enforcing"
msgstr "A SELinux kikényszerítő (enforcing) módban van"

#: crates/linux-defender-core/src/audit.rs:866
msgid "SELinux is in permissive mode"
msgstr "A SELinux megengedő (permissive) módban van"

#: crates/linux-defender-core/src/audit.rs:868
msgid "Consider switching to enforcing mode for stronger protection"
msgstr "Fontolja meg az enforcing módra váltást a fokozott védelem érdekében"

#: crates/linux-defender-core/src/audit.rs:880
msgid "SELinux is disabled"
msgstr "A SELinux le van tiltva"

#: crates/linux-defender-core/src/audit.rs:882
msgid "Enable SELinux for mandatory access control"
msgstr "Engedélyezze a SELinuxot a kötelező hozzáférés-vezérléshez"

#: crates/linux-defender-core/src/audit.rs:897
msgid "No mandatory access control framework detected"
msgstr "Nem található kötelező hozzáférés-vezérlési keretrendszer"

#: crates/linux-defender-core/src/audit.rs:899
msgid "Consider enabling AppArmor or SELinux"
msgstr "Érdemes engedélyezni az AppArmort vagy a SELinuxot"

#: crates/linux-defender-core/src/audit.rs:925
msgid "Automatic security updates are enabled"
msgstr "Az automatikus biztonsági frissítések engedélyezve vannak"

#: crates/linux-defender-core/src/audit.rs:936
msgid "Unattended upgrades is installed but disabled"
msgstr "A felügyelet nélküli frissítések telepítve vannak, de le vannak tiltva"

#: crates/linux-defender-core/src/audit.rs:938
msgid "Enable automatic security updates"
msgstr "Automatikus biztonsági frissítések engedélyezése"

#: crates/linux-defender-core/src/audit.rs:952
msgid "DNF automatic updates are enabled"
msgstr "A DNF automatikus frissítései engedélyezve vannak"

#: crates/linux-defender-core/src/audit.rs:963
msgid "DNF automatic is installed but timer is not active"
msgstr "A DNF automatic telepítve van, de az időzítő nem aktív"

#: crates/linux-defender-core/src/audit.rs:965
msgid "Enable automatic updates"
msgstr "Automatikus frissítések engedélyezése"

#: crates/linux-defender-core/src/audit.rs:979
msgid "Could not determine automatic update status"
msgstr "Nem sikerült megállapítani az automatikus frissítés állapotát"

#: crates/linux-defender-core/src/audit.rs:981
msgid "Configure automatic security updates"
msgstr "Automatikus biztonsági frissítések beállítása"

#: crates/linux-defender-core/src/audit.rs:996
msgid "System reboot required to apply updates"
msgstr "A frissítések alkalmazásához újra kell indítani a rendszert"

#: crates/linux-defender-core/src/audit.rs:998
msgid "Reboot the system to apply pending security updates"
msgstr ""
"Indítsa újra a rendszert a függőben lévő biztonsági frissítések "
"alkalmazásához"

#: crates/linux-defender-core/src/audit.rs:1044
msgid "{name} is installed but not running"
msgstr "A(z) {name} telepítve van, de nem fut"

#: crates/linux-defender-core/src/audit.rs:1063
msgid "No intrusion detection system found"
msgstr "Nem található behatolásészlelő rendszer"

#: crates/linux-defender-core/src/audit.rs:1065
msgid "Install fail2ban or CrowdSec to protect against attacks"
msgstr ""
"Telepítse a fail2ban vagy CrowdSec programot a támadások elleni védelemhez"

#: crates/linux-defender-core/src/audit.rs:1092
msgid "SSH server is not running (no remote attack surface)"
msgstr "Az SSH-kiszolgáló nem fut (nincs távoli támadási felület)"

#: crates/linux-defender-core/src/audit.rs:1103
msgid "SSH server is running"
msgstr "Az SSH-kiszolgáló fut"

#: crates/linux-defender-core/src/audit.rs:1113
msgid "Could not read SSH configuration"
msgstr "Nem sikerült beolvasni az SSH-beállításokat"

#: crates/linux-defender-core/src/audit.rs:1132
msgid "Root login: {value}"
msgstr "Root bejelentkezés: {value}"

#: crates/linux-defender-core/src/audit.rs:1140
msgid "Root login is allowed ({value})"
msgstr "A root bejelentkezés engedélyezett ({value})"

#: crates/linux-defender-core/src/audit.rs:1146
msgid "Disable root SSH login for security"
msgstr "Biztonsági okból tiltsa le a root SSH-bejelentkezést"

#: crates/linux-defender-core/src/audit.rs:1161
msgid "Password authentication is disabled (key-only)"
msgstr "A jelszavas hitelesítés le van tiltva (csak kulcs alapú)"

#: crates/linux-defender-core/src/audit.rs:1169
msgid "Password authentication is enabled"
msgstr "A jelszavas hitelesítés engedélyezve van"

#: crates/linux-defender-core/src/audit.rs:1171
msgid "Consider disabling password auth in favor of SSH keys"
msgstr "Fontolja meg a jelszavas hitelesítés letiltását SSH-kulcsok javára"

#: crates/linux-defender-core/src/audit.rs:1189
msgid "X11 forwarding is disabled"
msgstr "Az X11-továbbítás le van tiltva"

#: crates/linux-defender-core/src/audit.rs:1197
msgid "X11 forwarding is enabled"
msgstr "Az X11-továbbítás engedélyezve van"

#: crates/linux-defender-core/src/audit.rs:1199
msgid "Disable X11 forwarding to reduce attack surface"
msgstr "Tiltsa le az X11-továbbítást a támadási felület csökkentéséhez"

#: crates/linux-defender-core/src/audit.rs:1259
msgid "Application firewalls"
msgstr "Application firewalls"

#: crates/linux-defender-core/src/audit.rs:1282
msgid "Portmaster is running and protecting connections"
msgstr "A Portmaster fut, és védi a kapcsolatokat"

#
#: crates/linux-defender-core/src/audit.rs:1305
msgid "Authorize Linux Defender in Portmaster for per-module health"
msgstr ""
"Engedélyezze a Linux Defendert a Portmasterben a modulonkénti állapot "
"megtekintéséhez"

#: crates/linux-defender-core/src/audit.rs:1311
msgid "Authorize"
msgstr "Engedélyezés"

#: crates/linux-defender-core/src/audit.rs:1322
msgid "Portmaster is installed but not running"
msgstr "A Portmaster telepítve van, de nem fut"

#: crates/linux-defender-core/src/audit.rs:1324
msgid "Start the Portmaster service to enable network protection"
msgstr ""
"Indítsa el a Portmaster szolgáltatást a hálózati védelem engedélyezéséhez"

#. Translators: The em dash separates the detection result from the component description.
#: crates/linux-defender-core/src/audit.rs:1338
msgid "Not detected — optional network monitor and application firewall"
msgstr "Nem található — opcionális hálózati megfigyelő és alkalmazástűzfal"

#: crates/linux-defender-core/src/audit.rs:1354
msgid "Could not probe Portmaster: {error}"
msgstr "A Portmaster nem ellenőrizhető: {error}"

#: crates/linux-defender-core/src/audit.rs:1404
msgid "{name} is not installed"
msgstr "A(z) {name} nincs telepítve"

#: crates/linux-defender-core/src/audit.rs:1411
msgid "Install {name} for comprehensive security auditing"
msgstr "Telepítse a(z) {name} programot az átfogó biztonsági ellenőrzéshez"

#: crates/linux-defender-core/src/audit.rs:1417
msgid "Install chkrootkit for rootkit detection"
msgstr "Telepítse a chkrootkitet a rootkitek észleléséhez"

#: crates/linux-defender-core/src/audit.rs:1437
msgid "Authentication was cancelled"
msgstr "A hitelesítés megszakítva"

#: crates/linux-defender-core/src/audit.rs:1445
msgid "Lynis audit timed out after 5 minutes"
msgstr "A Lynis ellenőrzés 5 perc után időtúllépés miatt leállt"

#: crates/linux-defender-core/src/audit.rs:1447
msgid "Rootkit scan timed out after 5 minutes"
msgstr "A rootkitvizsgálat 5 perc után időtúllépés miatt leállt"

#: crates/linux-defender-core/src/audit.rs:1466
#: crates/linux-defender-core/src/audit.rs:1512
msgid "Failed to run Lynis: {error}"
msgstr "Nem sikerült futtatni a Lynis programot: {error}"

#: crates/linux-defender-core/src/audit.rs:1472
msgid "Failed to run chkrootkit: {error}"
msgstr "Nem sikerült futtatni a chkrootkit programot: {error}"

#: crates/linux-defender-core/src/audit.rs:1541
msgid "Score: {score}/100"
msgstr "Pontszám: {score}/100"

#. Translators: Keep the quoted shell command unchanged.
#: crates/linux-defender-core/src/audit.rs:1544
msgid "Run 'sudo lynis audit system' for detailed recommendations"
msgstr "A részletes javaslatokért futtassa: 'sudo lynis audit system'"

#: crates/linux-defender-core/src/audit.rs:1561
msgid "Audit completed (exit code {code})"
msgstr "Az ellenőrzés befejeződött (kilépési kód: {code})"

#: crates/linux-defender-core/src/audit.rs:1599
#: crates/linux-defender-core/src/audit.rs:1613
msgid "Rootkit scan could not be completed (exit {code})"
msgstr "A rootkitvizsgálat nem fejezhető be (kilépési kód: {code})"

#: crates/linux-defender-core/src/audit.rs:1650
msgid "No rootkits detected"
msgstr "Nem található rootkit"

#: crates/linux-defender-core/src/audit.rs:1662
msgid "{count} potential rootkit detected"
msgid_plural "{count} potential rootkits detected"
msgstr[0] "{count} lehetséges rootkit észlelve"
msgstr[1] "{count} lehetséges rootkit észlelve"

#: crates/linux-defender-core/src/audit.rs:1670
msgid "Investigate the detected threats immediately"
msgstr "Vizsgálja ki azonnal az észlelt fenyegetéseket"

#: crates/linux-defender-core/src/audit/firewall.rs:88
msgid "Firewall manager overlap"
msgstr "Tűzfalkezelők átfedése"

#: crates/linux-defender-core/src/audit/firewall.rs:89
msgid ""
"UFW is active while Firewalld owns its D-Bus name; their rule interaction "
"was not evaluated."
msgstr ""
"Az UFW aktív, miközben a Firewalld birtokolja a D-Bus-nevét; a szabályaik "
"kölcsönhatását nem értékeltük."

#: crates/linux-defender-core/src/audit/firewall.rs:207
msgid "UFW was not found at a trusted system path."
msgstr "Az UFW nem található megbízható rendszerútvonalon."

#. Translators: UFW is the name of the firewall application.
#: crates/linux-defender-core/src/audit/firewall.rs:210
#: crates/linux-defender-core/src/audit/firewall.rs:244
msgid ""
"Administrator authorization for the UFW status check was denied or "
"unavailable."
msgstr ""
"Administrator authorization for the UFW status check was denied or "
"unavailable."

#: crates/linux-defender-core/src/audit/firewall.rs:232
msgid "The UFW status check timed out."
msgstr "Az UFW státusz ellenőrzés időtúllépést okozott."

#. Translators: UFW is the name of the firewall application.
#: crates/linux-defender-core/src/audit/firewall.rs:235
#: crates/linux-defender-core/src/audit/firewall.rs:265
msgid "The UFW status check returned incomplete or invalid output."
msgstr "Az UFW státusz ellenőrzés többel hibás vagy hiányos kimenetet adott."

#: crates/linux-defender-core/src/audit/firewall.rs:253
msgid "The UFW status check failed."
msgstr "The UFW status check failed."

#: crates/linux-defender-core/src/audit/firewall.rs:382
msgid ""
"UFW is active; the default incoming policy is deny. Listed rules may allow "
"exceptions."
msgstr ""
"Az UFW aktív; az alapértelmezett bejövő házirend tiltás. A felsorolt "
"szabályok kivételeket engedélyezhetnek."

#: crates/linux-defender-core/src/audit/firewall.rs:389
msgid ""
"UFW is active; the default incoming policy is reject. Listed rules may allow "
"exceptions."
msgstr ""
"Az UFW aktív; az alapértelmezett bejövő házirend elutasítás. A felsorolt "
"szabályok kivételeket engedélyezhetnek."

#: crates/linux-defender-core/src/audit/firewall.rs:396
msgid "UFW is active; the default incoming policy is deny."
msgstr "Az UFW aktív; az alapértelmezett bejövő házirend tiltás."

#: crates/linux-defender-core/src/audit/firewall.rs:400
msgid "UFW is active; the default incoming policy is reject."
msgstr "Az UFW aktív; az alapértelmezett bejövő házirend elutasítás."

#: crates/linux-defender-core/src/audit/firewall.rs:404
msgid "UFW is active, but the default incoming policy allows traffic."
msgstr ""
"Az UFW aktív, de az alapértelmezett bejövő házirend engedélyezi a forgalmat."

#: crates/linux-defender-core/src/audit/firewall.rs:411
msgid "UFW is active, but its default incoming policy could not be verified."
msgstr ""
"Az UFW aktív, de az alapértelmezett bejövő házirendje nem volt ellenőrizhető."

#: crates/linux-defender-core/src/audit/firewall.rs:415
msgid ""
"UFW is inactive, but another firewall manager is active and protecting the "
"system."
msgstr ""
"UFW is inactive, but another firewall manager is active and protecting the "
"system."

#: crates/linux-defender-core/src/audit/firewall.rs:419
msgid "UFW reports inactive."
msgstr "Az UFW inaktív állapotot jelez."

#: crates/linux-defender-core/src/audit/firewall.rs:420
msgid ""
"UFW's service is active, but its default firewall policy could not be "
"verified without administrator access."
msgstr ""
"Az UFW aktív, de az alapértelmezett bejövő házirendje nem volt ellenőrizhető."

#: crates/linux-defender-core/src/audit/firewall.rs:424
msgid "UFW status could not be inspected safely."
msgstr "Az UFW állapotát nem lehetett biztonságosan ellenőrizni."

#: crates/linux-defender-core/src/audit/firewall.rs:436
msgid "UFW Firewall"
msgstr "UFW tűzfal"

#: crates/linux-defender-core/src/audit/firewall.rs:441
msgid "Check UFW with administrator access"
msgstr "UFW ellenőrzése adminisztrátori hozzáféréssel"

#: crates/linux-defender-core/src/audit/firewall.rs:443
msgid ""
"Administrator access may be required to read UFW status. This check does not "
"change firewall settings."
msgstr ""
"Administrator access may be required to read UFW status. This check does not "
"change firewall settings."

#: crates/linux-defender-core/src/audit/firewall.rs:481
msgid "Firewalld"
msgstr "Firewalld"

#: crates/linux-defender-core/src/audit/firewall.rs:483
msgid ""
"Firewalld owns its D-Bus name; readiness and firewall policy were not "
"queried."
msgstr ""
"A Firewalld birtokolja a D-Bus-nevét; a készenléti állapotot és a "
"tűzfalházirendet nem kérdeztük le."

#: crates/linux-defender-core/src/audit/firewall.rs:487
msgid ""
"No Firewalld D-Bus owner was observed; this does not establish kernel "
"firewall policy."
msgstr ""
"Nem észleltünk Firewalld D-Bus-tulajdonost; ez nem igazolja a kernel "
"tűzfalházirendjét."

#: crates/linux-defender-core/src/audit/firewall.rs:491
msgid ""
"Firewalld ownership could not be verified; readiness and firewall policy "
"were not queried."
msgstr ""
"A Firewalld tulajdonjoga nem volt ellenőrizhető; a készenléti állapotot és a "
"tűzfalházirendet nem kérdeztük le."

#: crates/linux-defender-core/src/audit/firewall.rs:506
msgid "firewall-cmd"
msgstr "firewall-cmd"

#: crates/linux-defender-core/src/audit/firewall.rs:512
msgid "firewall-cmd is installed; it was not executed."
msgstr "A firewall-cmd telepítve van; nem futtattuk."

#: crates/linux-defender-core/src/audit/firewall.rs:519
msgid "firewall-cmd could not be confirmed without executing it."
msgstr "A firewall-cmd futtatás nélkül nem volt megerősíthető."

#: crates/linux-defender-core/src/audit/firewall.rs:657
msgid "nftables (native rules)"
msgstr "nftables (natív szabályok)"

#: crates/linux-defender-core/src/audit/firewall.rs:659
msgid ""
"nftables has restrictive default input policies for IPv4 and IPv6; "
"individual rules may allow exceptions."
msgstr ""
"Az nftables korlátozó alapértelmezett bemeneti házirendekkel rendelkezik "
"IPv4 és IPv6 esetén; az egyes szabályok kivételeket engedélyezhetnek."

#: crates/linux-defender-core/src/audit/firewall.rs:663
msgid ""
"nftables reports a permissive default input policy; remaining coverage may "
"be incomplete"
msgstr ""
"Az nftables engedékeny alapértelmezett bemeneti házirendet jelez; a "
"fennmaradó lefedettség hiányos lehet"

#: crates/linux-defender-core/src/audit/firewall.rs:667
msgid ""
"nftables input policy coverage could not be verified for both IPv4 and IPv6"
msgstr ""
