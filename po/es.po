msgid "Firewall manager overlap"
msgstr "Superposición de gestores de cortafuegos"

#: crates/linux-defender-core/src/audit/firewall.rs:91
msgid ""
"UFW is active while Firewalld owns its D-Bus name; their rule interaction "
"was not evaluated."
msgstr ""
"UFW está activo mientras Firewalld posee su nombre D-Bus; no se evaluó la "
"interacción entre sus reglas."

#: crates/linux-defender-core/src/audit/firewall.rs:209
msgid "UFW was not found at a trusted system path."
msgstr "UFW no se encontró en una ruta de sistema confiable."

#. Translators: UFW is the name of the firewall application.
#: crates/linux-defender-core/src/audit/firewall.rs:212
#: crates/linux-defender-core/src/audit/firewall.rs:246
msgid ""
"Administrator authorization for the UFW status check was denied or "
"unavailable."
msgstr ""
"Administrator authorization for the UFW status check was denied or "
"unavailable."

#: crates/linux-defender-core/src/audit/firewall.rs:234
msgid "The UFW status check timed out."
msgstr "La comprobación del estado de UFW caducó."

#. Translators: UFW is the name of the firewall application.
#: crates/linux-defender-core/src/audit/firewall.rs:237
#: crates/linux-defender-core/src/audit/firewall.rs:267
msgid "The UFW status check returned incomplete or invalid output."
msgstr ""
"La comprobación del estado de UFW devolvió una salida incompleta o no válida."

#: crates/linux-defender-core/src/audit/firewall.rs:255
msgid "The UFW status check failed."
msgstr "The UFW status check failed."

#: crates/linux-defender-core/src/audit/firewall.rs:384
msgid ""
"UFW is active; the default incoming policy is deny. Listed rules may allow "
"exceptions."
msgstr ""
"UFW está activo; la política predeterminada de entrada es denegar. Las "
"reglas enumeradas pueden permitir excepciones."

#: crates/linux-defender-core/src/audit/firewall.rs:391
msgid ""
"UFW is active; the default incoming policy is reject. Listed rules may allow "
"exceptions."
msgstr ""
"UFW está activo; la política predeterminada de entrada es rechazar. Las "
"reglas enumeradas pueden permitir excepciones."

#: crates/linux-defender-core/src/audit/firewall.rs:398
msgid "UFW is active; the default incoming policy is deny."
msgstr "UFW está activo; la política predeterminada de entrada es denegar."

#: crates/linux-defender-core/src/audit/firewall.rs:402
msgid "UFW is active; the default incoming policy is reject."
msgstr "UFW está activo; la política predeterminada de entrada es rechazar."

#: crates/linux-defender-core/src/audit/firewall.rs:406
msgid "UFW is active, but the default incoming policy allows traffic."
msgstr ""
"UFW está activo, pero su política predeterminada de entrada permite el "
"tráfico."

#: crates/linux-defender-core/src/audit/firewall.rs:413
msgid "UFW is active, but its default incoming policy could not be verified."
msgstr ""
"UFW está activo, pero no se pudo verificar su política predeterminada de "
"entrada."

#: crates/linux-defender-core/src/audit/firewall.rs:417
msgid ""
"UFW is inactive, but another firewall manager is active and protecting the "
"system."
msgstr ""
"UFW is inactive, but another firewall manager is active and protecting the "
"system."

#: crates/linux-defender-core/src/audit/firewall.rs:421
msgid "UFW reports inactive."
msgstr "UFW informa que está inactivo."

#: crates/linux-defender-core/src/audit/firewall.rs:422
msgid ""
"UFW's service is active, but its default firewall policy could not be "
"verified without administrator access."
msgstr ""
"UFW está activo, pero no se pudo verificar su política predeterminada de "
"entrada."

#: crates/linux-defender-core/src/audit/firewall.rs:426
msgid "UFW status could not be inspected safely."
msgstr "No se pudo inspeccionar de forma segura el estado de UFW."

#: crates/linux-defender-core/src/audit/firewall.rs:438
msgid "UFW Firewall"
msgstr "Cortafuegos UFW"

#: crates/linux-defender-core/src/audit/firewall.rs:443
msgid "Check UFW with administrator access"
msgstr "Comprobar UFW con acceso de administrador"

#: crates/linux-defender-core/src/audit/firewall.rs:445
msgid ""
"Administrator access may be required to read UFW status. This check does not "
"change firewall settings."
msgstr ""
"Administrator access may be required to read UFW status. This check does not "
"change firewall settings."

#: crates/linux-defender-core/src/audit/firewall.rs:483
msgid "Firewalld"
msgstr "Firewalld"

#: crates/linux-defender-core/src/audit/firewall.rs:485
msgid ""
"Firewalld owns its D-Bus name; readiness and firewall policy were not "
"queried."
msgstr ""
"Firewalld posee su nombre D-Bus; no se consultaron la disponibilidad ni la "
"política del cortafuegos."

#: crates/linux-defender-core/src/audit/firewall.rs:489
msgid ""
"No Firewalld D-Bus owner was observed; this does not establish kernel "
"firewall policy."
msgstr ""
"No se observó ningún propietario D-Bus de Firewalld; esto no determina la "
"política del cortafuegos del kernel."

#: crates/linux-defender-core/src/audit/firewall.rs:493
msgid ""
"Firewalld ownership could not be verified; readiness and firewall policy "
"were not queried."
msgstr ""
"No se pudo verificar la propiedad de Firewalld; no se consultaron la "
"disponibilidad ni la política del cortafuegos."

#: crates/linux-defender-core/src/audit/firewall.rs:508
msgid "firewall-cmd"
msgstr "firewall-cmd"

#: crates/linux-defender-core/src/audit/firewall.rs:514
msgid "firewall-cmd is installed; it was not executed."
msgstr "firewall-cmd está instalado; no se ejecutó."

#: crates/linux-defender-core/src/audit/firewall.rs:521
msgid "firewall-cmd could not be confirmed without executing it."
msgstr "No se pudo confirmar firewall-cmd sin ejecutarlo."

#: crates/linux-defender-core/src/audit/firewall.rs:659
msgid "nftables (native rules)"
msgstr "nftables (reglas nativas)"

#: crates/linux-defender-core/src/audit/firewall.rs:661
msgid ""
"nftables has restrictive default input policies for IPv4 and IPv6; "
"individual rules may allow exceptions."
msgstr ""
"nftables tiene políticas predeterminadas de entrada restrictivas para IPv4 e "
"IPv6; las reglas individuales pueden permitir excepciones."

#: crates/linux-defender-core/src/audit/firewall.rs:665
msgid ""
"nftables reports a permissive default input policy; remaining coverage may "
"be incomplete"
msgstr ""
"nftables informa una política predeterminada de entrada permisiva; la "
"cobertura restante puede ser incompleta"

#: crates/linux-defender-core/src/audit/firewall.rs:669
msgid ""
"nftables input policy coverage could not be verified for both IPv4 and IPv6"
msgstr ""
"No se pudo verificar la cobertura de la política de entrada de nftables para "
"IPv4 e IPv6"

#: crates/linux-defender-core/src/audit/firewall.rs:729
msgid "iptables (IPv4)"
msgstr "iptables (IPv4)"

#: crates/linux-defender-core/src/audit/firewall.rs:731
msgid ""
"iptables has a restrictive INPUT default policy; individual rules may allow "
"exceptions."
msgstr ""
"iptables tiene una política predeterminada de INPUT restrictiva; las reglas "
"individuales pueden permitir excepciones."

#: crates/linux-defender-core/src/audit/firewall.rs:735
msgid "iptables has a permissive INPUT default policy"
msgstr "iptables tiene una política predeterminada permisiva para INPUT"

#: crates/linux-defender-core/src/audit/firewall.rs:736
msgid "iptables INPUT policy could not be verified"
msgstr "No se pudo verificar la política INPUT de iptables"

#: crates/linux-defender-core/src/audit/firewall.rs:742
msgid "iptables (IPv6)"
msgstr "iptables (IPv6)"

#: crates/linux-defender-core/src/audit/firewall.rs:744
msgid ""
"ip6tables has a restrictive INPUT default policy; individual rules may allow "
"exceptions."
msgstr ""
"ip6tables tiene una política predeterminada restrictiva para INPUT; las "
"reglas individuales pueden permitir excepciones."

#: crates/linux-defender-core/src/audit/firewall.rs:748
msgid "ip6tables has a permissive INPUT default policy"
msgstr "ip6tables tiene una política predeterminada permisiva para INPUT"

#: crates/linux-defender-core/src/audit/firewall.rs:749
msgid "ip6tables INPUT policy could not be verified"
msgstr "No se pudo verificar la política INPUT de ip6tables"

#: crates/linux-defender-core/src/audit/firewall.rs:793
msgid "Firewall"
msgstr "Cortafuegos"

