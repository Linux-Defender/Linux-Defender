msgstr ""
"Ủy quyền cho Linux Defender trong Portmaster để xem tình trạng từng mô-đun"

#: crates/linux-defender-core/src/audit.rs:1380
msgid "Authorize"
msgstr "Cấp quyền"

#: crates/linux-defender-core/src/audit.rs:1391
msgid "Portmaster is installed but not running"
msgstr "Portmaster đã được cài đặt nhưng không chạy"

#: crates/linux-defender-core/src/audit.rs:1393
msgid "Start the Portmaster service to enable network protection"
msgstr "Khởi động dịch vụ Portmaster để bật bảo vệ mạng"

