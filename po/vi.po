#: crates/linux-defender-core/src/audit.rs:578
msgid "Scheduled scans are enabled"
msgstr "Scheduled scans are enabled"

#: crates/linux-defender-core/src/audit.rs:586
msgid "Scheduled scans are not enabled"
msgstr "Quét theo lịch chưa được bật"

#: crates/linux-defender-core/src/audit.rs:588
msgid "Enable scheduled scans in Preferences → Schedule"
msgstr "Hãy bật quét theo lịch trong Tùy chọn → Lịch quét"

