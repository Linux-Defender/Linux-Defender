msgstr "Chuyển tiếp X11 đã bật"

#: crates/linux-defender-core/src/audit.rs:1268
msgid "Disable X11 forwarding to reduce attack surface"
msgstr "Tắt chuyển tiếp X11 để thu hẹp bề mặt tấn công"

#: crates/linux-defender-core/src/audit.rs:1328
msgid "Application firewalls"
msgstr "Application firewalls"

#: crates/linux-defender-core/src/audit.rs:1351
