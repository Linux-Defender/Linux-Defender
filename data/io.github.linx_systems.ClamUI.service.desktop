[Desktop Entry]
Type=Service
Name=Linux Defender Scanner
Comment=Scan files and folders with Linux Defender
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/octet-stream;inode/directory;
Actions=ScanWithLinuxDefender;
X-KDE-Priority=TopLevel

[Desktop Action ScanWithLinuxDefender]
Name=Scan with Linux Defender
Icon=io.github.linx_systems.ClamUI
Exec=clamui %F
