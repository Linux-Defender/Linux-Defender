<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Linux Defender</vendor>
  <vendor_url>https://github.com/Linux-Defender/Linux-Defender</vendor_url>
  <icon_name>io.github.linuxdefender.linuxdefender</icon_name>

  <action id="io.github.linux_defender.linuxdefender.apply-preferences">
    <description>Apply Linux Defender system configuration changes</description>
    <message>Authentication is required to save ClamAV system settings from Linux Defender.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/clamui-apply-preferences</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
