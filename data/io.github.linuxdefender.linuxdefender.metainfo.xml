    <releases>
        <release version="0.6.0" date="2026-11-11">
            <description>
                <p>Linux Defender 0.6.0 is a development snapshot. Signed Linux Defender release packages are not available yet.</p>
                <ul>
                    <li>Improves large-scan evidence retention, history and quarantine responsiveness, and daemon path handling.</li>
                    <li>Adds consent-based VirusTotal folder and URL analysis, urlscan URL checks, and visible upload progress.</li>
                    <li>Connects standalone YARA scans to the configured host ClamAV database and exposes a signature inventory.</li>
                </ul>
            </description>
        </release>
