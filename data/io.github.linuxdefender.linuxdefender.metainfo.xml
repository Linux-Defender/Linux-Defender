<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>io.github.linuxdefender.linuxdefender</id>
    <name>Linux Defender</name>
    <summary>Linux desktop security scanner</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>MIT</project_license>

    <developer id="io.github.linuxdefender">
        <name>Kira (Linux-Defender)</name>
    </developer>

    <description>
        <p>
            Linux Defender is a Linux desktop security scanner built with Rust, Tauri,
            and React. It uses host-installed ClamAV for local scanning and offers
            optional, consent-based VirusTotal and urlscan reputation checks.
        </p>
        <p>Features:</p>
        <ul>
            <li>Select files or directories to scan using the native file dialog</li>
            <li>Background scanning keeps the UI responsive during long scans</li>
            <li>Clear, readable display of scan results</li>
            <li>Graceful handling when ClamAV is not installed</li>
            <li>Scan profiles, scheduling, history, and hash-verified quarantine</li>
            <li>System audit and desktop integration for supported file managers</li>
        </ul>
    </description>


