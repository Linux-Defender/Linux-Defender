[Desktop Entry]
Type=Service
Name=Linux Defender VirusTotal Scanner
Comment=Scan files with VirusTotal online service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;
Actions=ScanWithVirusTotal;
X-KDE-Priority=TopLevel

[Desktop Action ScanWithVirusTotal]
Name=Scan with VirusTotal
Icon=io.github.linuxdefender.linuxdefender
Exec=linux-defender --virustotal %F
