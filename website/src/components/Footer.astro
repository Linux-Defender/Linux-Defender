---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="border-t hairline mt-10">
  <div class="container-tight py-12 grid gap-10 sm:grid-cols-[auto_1fr_auto] items-start">
    <div class="flex items-center gap-2.5">
      <img
        src={`${base}/favicon.svg`}
        alt=""
        width="24"
        height="24"
        loading="lazy"
        decoding="async"
        class="rounded"
      />
      <span class="font-semibold tracking-tight text-white">Linux Defender</span>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 sm:grid-cols-3 gap-6 text-sm">
      <div>
        <div class="text-white/40 text-[11px] uppercase tracking-wider font-mono mb-2">Project</div>
        <ul class="space-y-1.5">
          <li><a class="text-white/75 hover:text-white" href="https://github.com/Linux-Defender/Linux-Defender" rel="noopener">Repository</a></li>
          <li><a class="text-white/75 hover:text-white" href="https://github.com/Linux-Defender/Linux-Defender/issues" rel="noopener">Issues</a></li>
          <li><a class="text-white/75 hover:text-white" href="https://github.com/Linux-Defender/Linux-Defender/releases" rel="noopener">Releases</a></li>
        </ul>
      </div>
      <div>
        <div class="text-white/40 text-[11px] uppercase tracking-wider font-mono mb-2">Docs</div>
        <ul class="space-y-1.5">
          <li><a class="text-white/75 hover:text-white" href={`${base}/docs/`}>Documentation</a></li>
          <li><a class="text-white/75 hover:text-white" href={`${base}/docs/installation/`}>Installation</a></li>
          <li><a class="text-white/75 hover:text-white" href={`${base}/docs/troubleshooting/`}>Troubleshooting</a></li>
        </ul>
      </div>
      <div>
        <div class="text-white/40 text-[11px] uppercase tracking-wider font-mono mb-2">Legal</div>
        <ul class="space-y-1.5">
          <li><a class="text-white/75 hover:text-white" href="https://github.com/Linux-Defender/Linux-Defender/blob/main/LICENSE" rel="noopener">License and attribution</a></li>
          <li><a class="text-white/75 hover:text-white" href={`${base}/docs/contributing/security/`}>Security</a></li>
        </ul>
      </div>
    </nav>
    <div class="text-xs text-white/45 sm:text-right">
      <div>Built for the Linux desktop.</div>
      <div class="mt-1 font-mono">Maintained by <a class="hover:text-white" href="https://github.com/SAFETY-CHAT" rel="noopener">Kira (SAFETY-CHAT)</a></div>
    </div>
  </div>
</footer>
