---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ValuePillars from "../components/ValuePillars.astro";
import FeatureRow from "../components/FeatureRow.astro";
import WhyLinuxAV from "../components/WhyLinuxAV.astro";
import InstallTabs from "../components/InstallTabs.astro";
import Footer from "../components/Footer.astro";
import { features } from "../content/features";
---

<Base>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <ValuePillars />

    <section id="features" class="container-tight py-10 sm:py-16">
      <div class="max-w-2xl mb-10 sm:mb-16">
        <span class="eyebrow">One app, clear boundaries</span>
        <h2 class="mt-3 section-title">The tools in one place</h2>
        <p class="mt-4 lede">
          Local scanning, quarantine, system checks, and optional online reputation workflows in one Linux desktop app.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {features.map((f, i) => <FeatureRow feature={f} index={i} />)}
      </div>
    </section>

    <WhyLinuxAV />
    <section id="docs-start" class="container-tight py-10 sm:py-16">
      <div class="max-w-2xl mb-8">
        <span class="eyebrow">Documentation</span>
        <h2 class="mt-3 section-title">Find your next step</h2>
        <p class="mt-4 lede">Install, scan, configure, or contribute — the guides are organized by task.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <a class="card group hover:border-guard-forest/40 transition-colors" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/docs/installation/`}>
          <span class="eyebrow">Start here</span>
          <h3 class="mt-2 text-lg font-semibold text-white">Installation</h3>
          <p class="mt-2 text-sm text-white/60">Runtime and package requirements for every format.</p>
        </a>
        <a class="card group hover:border-guard-forest/40 transition-colors" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/docs/getting-started/`}>
          <span class="eyebrow">First scan</span>
          <h3 class="mt-2 text-lg font-semibold text-white">Getting started</h3>
          <p class="mt-2 text-sm text-white/60">Run your first local scan and read the results.</p>
        </a>
        <a class="card group hover:border-guard-forest/40 transition-colors" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/docs/`}>
          <span class="eyebrow">Use</span>
          <h3 class="mt-2 text-lg font-semibold text-white">User guides</h3>
          <p class="mt-2 text-sm text-white/60">Scanning, quarantine, schedules, privacy, and troubleshooting.</p>
        </a>
        <a class="card group hover:border-guard-forest/40 transition-colors" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/docs/contributing/development/`}>
          <span class="eyebrow">Contribute</span>
          <h3 class="mt-2 text-lg font-semibold text-white">Development</h3>
          <p class="mt-2 text-sm text-white/60">Source, validation, architecture, and packaging.</p>
        </a>
      </div>
    </section>
    <InstallTabs />
  </main>
  <Footer />
</Base>
