[Desktop Entry]
Type=Application
Name=Linux Defender
GenericName=Antivirus Scanner
Comment=Scan files and review Linux security with ClamAV
Exec=clamui %U
Icon=io.github.linux-defender.linux-defender
Terminal=false
Categories=GTK;Utility;Security;
Keywords=antivirus;virus;scanner;clamav;security;malware;virustotal;
StartupNotify=true
StartupWMClass=io.github.linux-defender.linux-defender
NoDisplay=false
