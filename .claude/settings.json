{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/ai-enforcement-context.py", "SessionStart"],
            "statusMessage": "Loading Linux Defender enforcement rules..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/ai-enforcement-context.py", "UserPromptSubmit"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/check-all.sh",
            "timeout": 300,
            "statusMessage": "Running Linux Defender static consistency checks..."
          }
        ]
      }
    ]
  }
}
