#!/bin/bash
# Git pre-commit hook: enforcement that actually blocks stale/dead/unwired work.
# Runs the full static check suite on EVERY commit, regardless of which files
# changed, because cross-layer drift is invisible when looking at one file.
# Install with ./scripts/hooks/install-hooks.sh.
# Bypass only for genuine emergencies with: git commit --no-verify

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT"

echo "Running static consistency checks (dead links, dead files, cross-layer parity, gettext, skills)..."
bash scripts/check-all.sh

mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMR)

has_rust_source=false
has_frontend_source=false
for file in "${STAGED_FILES[@]}"; do
    case "$file" in
        *.rs)
            has_rust_source=true
            ;;
        desktop/*.ts|desktop/*.tsx|desktop/**/*.ts|desktop/**/*.tsx|desktop/package.json|desktop/bun.lock|desktop/tsconfig*.json)
            has_frontend_source=true
            ;;
    esac
done

if "$has_rust_source"; then
    echo "Checking Rust formatting..."
    cargo fmt --check --all
fi

if "$has_frontend_source"; then
    echo "Type-checking TypeScript frontend..."
    ( cd desktop && bun run check )
fi
