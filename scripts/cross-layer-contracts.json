{
  "version": 1,
  "purpose": "Cross-layer feature contracts. Every feature below MUST appear in each declared layer. A feature added to only one scanner/runtime/doc layer fails scripts/check-cross-layer.py. Add a contract entry when introducing any cross-cutting feature.",
  "layers": {
    "core": {
      "paths": [
        "crates/"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "runtime": {
      "paths": [
        "desktop/src-tauri/"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "frontend": {
      "paths": [
        "desktop/src/"
      ],
      "extensions": [
        ".ts",
        ".tsx"
      ]
    },
    "site": {
      "paths": [
        "website/src/content/"
      ],
      "extensions": [
        ".md",
        ".mdx"
      ]
    },
    "packaging": {
      "paths": [
        "debian/",
        "flathub/",
        "appimage/",
        "snap/",
        "aur/",
        "scripts/",
        "rpm/",
        "data/"
      ],
      "extensions": [
        "",
        ".sh",
        ".md",
        ".json",
        ".toml",
        ".xml",
        ".yaml",
        ".yml"
      ]
    },
    "docs": {
      "paths": [
        "docs/"
      ],
      "extensions": [
        ".md"
      ]
    }
  },
  "features": [
    {
      "id": "urlhaus",
      "why": "Default URLhaus feed must be known to the core, visible in the UI, and documented on the site.",
      "layers": {
        "core": [
          "urlhaus",
          "4bf8c78f1e2c86892a179019b21653d9c6f8469596e87501"
        ],
        "frontend": [
          "urlhaus"
        ],
        "site": [
          "urlhaus"
        ],
        "docs": [
          "urlhaus"
        ]
      }
    },
    {
      "id": "privileged-helper",
      "why": "Host preference writes must exist in the core protocol, native runtime, UI, docs, and packages.",
      "layers": {
        "core": [
          "apply-preferences"
        ],
        "runtime": [
          "apply-preferences"
        ],
        "frontend": [
          "apply-preferences"
        ],
        "site": [
          "apply-preferences"
        ],
        "packaging": [
          "apply-preferences"
        ],
        "docs": [
          "apply-preferences"
        ]
      }
    },
    {
      "id": "compat-alias-helper",
      "why": "The pre-rename helper alias is an upgrade contract, not branding to drop.",
      "layers": {
        "core": [
          "clamui-apply-preferences"
        ],
        "runtime": [
          "clamui-apply-preferences"
        ],
        "docs": [
          "clamui-apply-preferences"
        ],
        "site": [
          "clamui-apply-preferences"
        ]
      }
    },
    {
      "id": "compat-alias-scheduler",
      "why": "The pre-rename scheduled-scan alias is an upgrade contract.",
      "layers": {
        "core": [
          "clamui-scheduled-scan"
        ],
        "runtime": [
          "clamui-scheduled-scan"
        ],
        "site": [
          "clamui-scheduled-scan"
        ],
        "docs": [
          "clamui-scheduled-scan"
        ]
      }
    },
    {
      "id": "event-channel",
      "why": "Core emits {event,data}; the native bridge forwards on one named channel and the frontend/site must agree.",
      "layers": {
        "runtime": [
          "linux-defender-event"
        ],
        "frontend": [
          "linux-defender-event"
        ],
        "site": [
          "linux-defender-event"
        ],
        "docs": [
          "linux-defender-event"
        ],
        "core": [
          "pub event: String"
        ]
      }
    },
    {
      "id": "virustotal",
      "why": "Online hash checking must be wired across core, runtime, UI, and docs.",
      "layers": {
        "core": [
          "virustotal"
        ],
        "runtime": [
          "virustotal"
        ],
        "frontend": [
          "virustotal"
        ],
        "site": [
          "virustotal"
        ]
      }
    },
    {
      "id": "urlscan",
      "why": "Online URL checking must be wired across core, UI, and docs.",
      "layers": {
        "core": [
          "urlscan"
        ],
        "frontend": [
          "urlscan"
        ],
        "site": [
          "urlscan"
        ]
      }
    },
    {
      "id": "scheduler",
      "why": "Scheduled scans must exist in core, UI, and docs.",
      "layers": {
        "core": [
          "schedul"
        ],
        "frontend": [
          "schedul"
        ],
        "site": [
          "schedul"
        ]
      }
    },
    {
      "id": "quarantine",
      "why": "Quarantine must exist in core, UI, and docs.",
      "layers": {
        "core": [
          "quarantine"
        ],
        "frontend": [
          "quarantine"
        ],
        "site": [
          "quarantine"
        ]
      }
    },
    {
      "id": "yara",
      "why": "Local YARA rules must exist in core, UI, and docs.",
      "layers": {
        "core": [
          "yara"
        ],
        "frontend": [
          "yara"
        ],
        "site": [
          "yara"
        ]
      }
    },
    {
      "id": "in-app-docs-link",
      "why": "The desktop About dialog must offer a safe, allowlisted link to the published documentation without adding a new untranslated string.",
      "layers": {
        "frontend": [
          "DOCS_URL"
        ],
        "site": [
          "Installation"
        ]
      }
    },
    {
      "id": "host-tool-guidance",
      "why": "App and website host-ClamAV setup commands must match each other and the reviewed upstream distro set.",
      "layers": {
        "frontend": [
          "Fedora Atomic"
        ],
        "site": [
          "systemctl enable --now"
        ],
        "docs": [
          "component guides"
        ]
      }
    },
    {
      "id": "integration-asset-parity",
      "why": "File-manager launcher assets must use the correct command variant per format and ship the same eight actions everywhere.",
      "layers": {
        "packaging": [
          "integrations-native",
          "flatpak run"
        ],
        "docs": [
          "file-manager"
        ],
        "site": [
          "Flatpak"
        ]
      }
    },
    {
      "id": "packaging-parity",
      "why": "Every supported package format must stay version-matched, rebranded, workflow-covered, badge-documented, and host-ClamAV-only.",
      "layers": {
        "packaging": [
          "PKGBUILD",
          "snapcraft.yaml",
          "build-appimage.sh"
        ],
        "docs": [
          "Packaging matrix"
        ],
        "site": [
          "AUR"
        ]
      }
    },
    {
      "id": "arch-aur-sway",
      "why": "Arch/AUR source packaging and Sway/wlroots tray support must stay wired across recipes, internal docs, and the published guides.",
      "layers": {
        "packaging": [
          "PKGBUILD",
          "waybar"
        ],
        "docs": [
          "Sway"
        ],
        "site": [
          "AUR"
        ]
      }
    },
    {
      "id": "host-signature-database",
      "why": "Host FreshClam database handling must exist in core, UI, site, docs, and packages; Linux Defender never bundles an engine or database.",
      "layers": {
        "core": [
          "freshclam",
          "databasedirectory"
        ],
        "frontend": [
          "freshclam"
        ],
        "site": [
          "freshclam"
        ],
        "docs": [
          "freshclam"
        ],
        "packaging": [
          "freshclam"
        ]
      }
    },
    {
      "id": "deep-scan-audit",
      "why": "The opt-in system deep scans must stay present in the core, UI, site, and fork status.",
      "layers": {
        "core": [
          "rkhunter",
          "chkrootkit",
          "lynis"
        ],
        "frontend": [
          "rkhunter",
          "Run all security scans",
          "System Security Check"
        ],
        "site": [
          "rkhunter",
          "Run all security scans",
          "System Security Check"
        ],
        "docs": [
          "rkhunter",
          "deep scan",
          "System Security Check"
        ]
      }
    },
    {
      "id": "portmaster",
      "why": "Portmaster audit check and authorization stay wired across core, runtime, frontend, site and parity docs.",
      "layers": {
        "core": [
          "portmaster"
        ],
        "frontend": [
          "portmaster"
        ],
        "site": [
          "Portmaster"
        ],
        "docs": [
          "Portmaster"
        ]
      }
    },
    {
      "id": "tray-close-behavior",
      "why": "Tray minimize/start settings stay consistent across core, runtime, frontend and site.",
      "layers": {
        "core": [
          "start_minimized"
        ],
        "runtime": [
          "start_minimized"
        ],
        "frontend": [
          "close_behavior"
        ],
        "site": [
          "Start in System Tray"
        ],
        "docs": [
          "Sway"
        ]
      }
    }
  ]
}
